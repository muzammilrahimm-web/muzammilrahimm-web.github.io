---
// CategoryLayout: one reusable template for Bedroom, Kitchen, Closet and Small Spaces.
// Each category page just passes its slug, e.g. <CategoryLayout slug="kitchen" />.
// Text comes from src/data/content.js; design ideas from src/content/ideas/<slug>/;
// articles from src/content/blog. Nothing here needs editing to add more ideas.
import BaseLayout from './BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import Newsletter from '../components/Newsletter.astro';
import CategoryHero from '../components/ideas/CategoryHero.astro';
import FeaturedIdea from '../components/ideas/FeaturedIdea.astro';
import IdeaCard from '../components/ideas/IdeaCard.astro';
import IdeaBrowser from '../components/ideas/IdeaBrowser.astro';
import { CATEGORIES, getCategory } from '../data/content.js';
import { getPosts, getPostsForCategory, toCardProps } from '../lib/blog.js';
import { getIdeas, getCategorySections } from '../lib/ideas.js';
import '../styles/ideas.css';

const { slug } = Astro.props;
const category = getCategory(slug);

// Design ideas for this category (newest first) and the highlight sections.
const ideas = await getIdeas(slug);
const { featured, popular, trending } = getCategorySections(ideas);

// Related blog articles: this category's articles first, then others to fill the row.
const posts = await getPosts();
const { inCategory, list: related } = getPostsForCategory(posts, slug, 3);
const otherCategories = CATEGORIES.filter((c) => c.slug !== slug);
---

<BaseLayout title={category.seoTitle} description={category.seoDescription} image={category.image}>
  <div class="category" style={`--cat-tint:${category.theme.tint};--cat-deep:${category.theme.deep}`}>
    <CategoryHero category={category} ideas={ideas} postCount={inCategory.length} />

    {
      featured && (
        <section class="section" aria-labelledby="featured-title">
          <div class="container">
            <SectionHeading eyebrow="Editor's choice" title="Featured design idea" id="featured-title" />
            <FeaturedIdea idea={featured} />
          </div>
        </section>
      )
    }

    {
      popular.length > 0 && (
        <section class="section category__tinted" aria-labelledby="popular-title">
          <div class="container">
            <SectionHeading
              eyebrow="Hand-picked by the Nestora team"
              title="Popular ideas"
              id="popular-title"
            />
            <div class="idea-masonry">
              {popular.map((idea) => <IdeaCard idea={idea} />)}
            </div>
          </div>
        </section>
      )
    }

    {
      trending.length > 0 && (
        <section class="section" aria-labelledby="trending-title">
          <div class="container">
            <SectionHeading
              eyebrow="Fresh & seasonal"
              title="Trending inspiration"
              intro="Seasonal ideas and fresh looks our editors are loving right now."
              id="trending-title"
            />
            <div class="idea-strip">
              {trending.map((idea) => <IdeaCard idea={idea} />)}
            </div>
          </div>
        </section>
      )
    }

    {ideas.length > 0 && <IdeaBrowser category={category} ideas={ideas} title={`Latest ${category.name.toLowerCase()} ideas`} />}

    <section class="section category__tinted" id="tips" aria-labelledby="tips-title">
      <div class="container">
        <SectionHeading eyebrow="Start here" title="Simple ideas to try this week" id="tips-title" />
        <ol class="tips">
          {
            category.tips.map((tip, i) => (
              <li class="tip">
                <span class="tip__number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="tip__title">{tip.title}</h3>
                <p>{tip.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {
      related.length > 0 && (
        <section class="section" aria-labelledby="related-title">
          <div class="container">
            <SectionHeading
              eyebrow="From the blog"
              title={inCategory.length > 0 ? `${category.name} articles` : 'Related articles'}
              intro={inCategory.length > 0
                ? undefined
                : `We're writing our first ${category.name.toLowerCase()} articles. Until then, these guides use the same small-space ideas.`}
              id="related-title"
            />
            <div class="grid grid--3">
              {related.map((post) => <ArticleCard {...toCardProps(post)} />)}
            </div>
            <div class="related-cta">
              <a href="/blog" class="btn btn--ghost">View all articles</a>
            </div>
          </div>
        </section>
      )
    }

    <section class="section section--beige" aria-labelledby="more-rooms-title">
      <div class="container">
        <SectionHeading eyebrow="Keep exploring" title="More rooms" id="more-rooms-title" />
        <div class="grid grid--3">
          {otherCategories.map((c) => <CategoryCard title={c.title} blurb={c.blurb} href={c.href} image={c.image} alt={c.alt} />)}
        </div>
      </div>
    </section>

    <Newsletter />
  </div>
</BaseLayout>

<style>
  .category__tinted {
    background: var(--cat-tint);
  }

  .tips {
    display: grid;
    gap: var(--space-md);
    list-style: none;
    padding: 0;
  }

  @media (min-width: 768px) {
    .tips {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .tip {
    display: grid;
    gap: 0.5rem;
    padding: var(--space-md);
    border-top: 1px solid var(--cat-deep);
  }

  .tip__number {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--sage-dark);
  }

  .tip p {
    color: var(--ink-soft);
  }

  .related-cta {
    display: flex;
    justify-content: center;
    margin-top: var(--space-lg);
  }
</style>
