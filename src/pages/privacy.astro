---
// /privacy: Privacy Policy (PLACEHOLDER: needs a professionally written policy before launch)
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout title="Privacy Policy" description="How Nestora handles your information. Full privacy policy coming soon.">
  <PageHero eyebrow="Legal" title="Privacy Policy" />

  <section class="section">
    <div class="container prose">
      <p class="demo-note">
        Placeholder: a full Privacy Policy covering US and UK requirements (including UK GDPR) will
        be published here before accounts or the newsletter go live.
      </p>
      <h2>What this website does today</h2>
      <ul>
        <li>The sign up, log in, password reset, newsletter and contact forms are not connected to any server. They do not send or store any information.</li>
        <li>If you choose to email us, your email is handled by your own email provider and ours.</li>
        <li>Fonts are loaded from Google Fonts, which means your browser connects to Google's servers to download them.</li>
        <li>Photos are hosted on this website.</li>
      </ul>
    </div>
  </section>
</BaseLayout>
