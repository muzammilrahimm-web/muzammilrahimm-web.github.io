---
// /contact: Contact page.
// The form is FRONTEND ONLY: it checks the details but does NOT send anything.
// After a valid submit it offers to open the visitor's own email app instead.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FormField from '../components/auth/FormField.astro';
import { SITE } from '../config/site.js';
---

<BaseLayout
  title="Contact Us"
  description="Get in touch with Nestora about home decor and small-space organization ideas, article suggestions or feedback. Email us directly."
>
  <PageHero
    eyebrow="Contact us"
    title="We'd love to hear from you"
    intro="Questions, article ideas or a small-space win you're proud of? Send us a note."
  />

  <section class="section">
    <div class="container contact">
      <aside class="contact__info" aria-labelledby="contact-info-title">
        <h2 id="contact-info-title" class="contact__heading">Email us directly</h2>
        <p>The quickest way to reach us is by email:</p>
        <a class="contact__email" href={`mailto:${SITE.email}`}>
          <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.6" />
            <path d="m4 7 8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          {SITE.email}
        </a>

        <h3 class="contact__subheading">What you can write to us about</h3>
        <ul class="contact__list">
          <li>Questions about an article or idea</li>
          <li>Topics you'd like us to cover</li>
          <li>Corrections or feedback</li>
          <li>Partnership enquiries</li>
        </ul>

        <div class="demo-note" role="note">
          <p>
            <strong>Please note:</strong> the contact form on this page is not connected to an email
            service yet, so it cannot send messages. Use the email link above, or fill in the form and
            we'll help you open the message in your own email app.
          </p>
        </div>
      </aside>

      <div class="contact__form-card">
        <h2 class="contact__heading">Send a message</h2>
        <form
          class="contact__form"
          method="post"
          novalidate
          data-validate
          data-contact-form
          data-error-message="Please fix the highlighted fields and try again."
          data-success-message="Your message has NOT been sent. This form isn't connected to an email service yet."
        >
          <div class="contact__row">
            <FormField id="name" label="Name" autocomplete="name" required maxlength="100" />
            <FormField id="email" label="Email address" type="email" autocomplete="email" placeholder="you@example.com" required maxlength="254" />
          </div>
          <FormField id="subject" label="Subject" required minlength="3" maxlength="150" />
          <FormField
            id="message"
            label="Message"
            type="textarea"
            required
            minlength="10"
            maxlength="3000"
            rows="7"
            hint="At least 10 characters."
          />

          <button type="submit" class="btn btn--primary">Check &amp; continue</button>

          <div class="form-status" data-form-status role="status" aria-live="polite" hidden></div>
          <a class="btn btn--ghost" href={`mailto:${SITE.email}`} data-mailto hidden>Open in your email app</a>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initForms } from '../scripts/forms.js';
  initForms();

  // After a valid submit: build a mailto: link with the visitor's message so
  // they can send it from their own email app. Nothing is sent by this website.
  const form = document.querySelector('[data-contact-form]');
  const mailto = form.querySelector('[data-mailto]');
  const baseHref = mailto.getAttribute('href');

  form.addEventListener('form:valid', () => {
    const value = (id) => form.querySelector(`#${id}`).value.trim();
    const body = `${value('message')}\n\n${value('name')}\n${value('email')}`;
    mailto.href = `${baseHref}?subject=${encodeURIComponent(value('subject'))}&body=${encodeURIComponent(body)}`;
    mailto.hidden = false;
  });

  // Hide the email-app button again if the form becomes invalid.
  form.addEventListener('submit', () => {
    mailto.hidden = true;
  }, { capture: true });
</script>

<style>
  .contact {
    display: grid;
    gap: var(--space-lg);
    align-items: start;
  }

  @media (min-width: 960px) {
    .contact {
      grid-template-columns: 0.85fr 1.15fr;
      gap: var(--space-xl);
    }
  }

  .contact__info {
    display: grid;
    gap: var(--space-sm);
  }

  .contact__heading {
    font-size: clamp(1.7rem, 3vw, 2.2rem);
  }

  .contact__subheading {
    margin-top: var(--space-sm);
    font-size: 1.35rem;
  }

  .contact__email {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    justify-self: start;
    max-width: 100%;
    padding: 0.85rem 1.2rem;
    border: 1px solid var(--beige-deep);
    border-radius: var(--radius);
    background: var(--ivory-soft);
    font-size: 1.05rem;
    font-weight: 500;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: border-color 0.2s var(--ease), background-color 0.2s var(--ease);
  }

  .contact__email:hover {
    border-color: var(--sage);
    background: var(--white);
  }

  .contact__email svg {
    flex-shrink: 0;
  }

  .contact__list {
    display: grid;
    gap: 0.4rem;
    padding-left: 1.2rem;
    color: var(--ink-soft);
  }

  .contact__list li::marker {
    color: var(--sage-dark);
  }

  .contact__form-card {
    display: grid;
    gap: var(--space-md);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--ivory-soft);
    box-shadow: var(--shadow);
  }

  .contact__form {
    display: grid;
    gap: 1.1rem;
  }

  .contact__form .btn {
    justify-self: start;
  }

  .contact__row {
    display: grid;
    gap: 1.1rem;
  }

  @media (min-width: 640px) {
    .contact__row {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
