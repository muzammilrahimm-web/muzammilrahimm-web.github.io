---
// /forgot-password: password reset request (FRONTEND ONLY, no email is sent).
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthShell from '../components/auth/AuthShell.astro';
import FormField from '../components/auth/FormField.astro';
import image from '../assets/images/bright-apartment.jpg';
---

<BaseLayout
  title="Forgot Password"
  description="Reset your Nestora account password. Accounts are coming soon."
  noindex
>
  <AuthShell
    title="Reset your password"
    intro="Enter your email and we'll send you a link to reset your password."
    image={image}
    imageAlt="Bright, spacious apartment living room with beige sofas, teal cushions and large windows overlooking the city"
  >
    <form
      class="auth-form"
      method="post"
      novalidate
      data-validate
      data-success-message="Your email address looks good. Password reset isn't available yet, so no email was sent."
    >
      <FormField id="email" label="Email address" type="email" autocomplete="email" placeholder="you@example.com" required />
      <button type="submit" class="btn btn--primary btn--block">Send Reset Link</button>
      <p class="form-status" data-form-status role="status" hidden></p>
    </form>

    <p class="auth-switch"><a href="/login">← Back to log in</a></p>
  </AuthShell>
</BaseLayout>

<style>
  .auth-form {
    display: grid;
    gap: 1.1rem;
  }

  .auth-switch {
    text-align: center;
    font-size: 0.95rem;
  }
</style>
