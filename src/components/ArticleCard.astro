---
// ArticleCard: image, category, date, title and short description.
//
// Two ways to use it:
// 1. Real blog article: pass `href` (and `date`). The whole card links to the article.
// 2. Demo card (no `href`): shows a "Demo content" badge and links to the
//    related category page instead, so there are no broken links.
import { Image } from 'astro:assets';
import DemoBadge from './DemoBadge.astro';
import { getCategory } from '../data/content.js';
import { formatDate } from '../lib/blog.js';

const {
  title,
  excerpt,
  category,
  image,
  alt,
  href,
  date,
  demo = !href,
  headingLevel = 3,
  loading = 'lazy',
} = Astro.props;

const cat = getCategory(category);
const Heading = `h${headingLevel}`;
---

<article
  class:list={['article-card', { 'article-card--linked': href }]}
  data-article
  data-category={category}
  data-search={`${title} ${excerpt} ${cat?.name ?? ''} ${cat?.title ?? ''}`.toLowerCase()}
>
  <div class="article-card__media">
    <Image
      src={image}
      alt={alt}
      widths={[400, 700, 1000]}
      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
      loading={loading}
    />
  </div>
  <div class="article-card__body">
    <div class="article-card__meta">
      {cat && <span class="article-card__category">{cat.name}</span>}
      {date && <time class="article-card__date" datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>}
      {demo && <DemoBadge />}
    </div>
    <Heading class="article-card__title">
      {href ? <a href={href} class="article-card__title-link">{title}</a> : title}
    </Heading>
    <p class="article-card__excerpt">{excerpt}</p>
    {
      href ? (
        <span class="article-card__more" aria-hidden="true">
          Read article
          <svg width="16" height="16" viewBox="0 0 24 24">
            <path d="M5 12h14m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      ) : (
        cat && (
          <a href={cat.href} class="text-link article-card__link">
            More {cat.name.toLowerCase()} ideas<span class="visually-hidden">: related to {title}</span>
          </a>
        )
      )
    }
  </div>
</article>

<style>
  .article-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--ivory-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }

  .article-card--linked:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }

  .article-card__media {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--beige);
  }

  .article-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .article-card:hover .article-card__media :global(img) {
    transform: scale(1.04);
  }

  .article-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    flex: 1;
    padding: var(--space-md);
  }

  .article-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.9rem;
    font-size: 0.8rem;
  }

  .article-card__category {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sage-dark);
  }

  .article-card__date {
    color: var(--ink-soft);
  }

  .article-card__title {
    font-size: clamp(1.35rem, 2vw, 1.6rem);
  }

  .article-card__title-link {
    color: var(--ink);
    text-decoration: none;
  }

  /* Makes the whole card clickable while keeping one accessible link */
  .article-card__title-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .article-card__excerpt {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .article-card__link,
  .article-card__more {
    align-self: flex-start;
    margin-top: auto;
    padding-top: 0.25rem;
    font-size: 0.9rem;
  }

  .article-card__more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 500;
    color: var(--sage-dark);
  }

  .article-card--linked:hover .article-card__more svg {
    transform: translateX(3px);
  }

  .article-card__more svg {
    transition: transform 0.25s var(--ease);
  }
</style>
