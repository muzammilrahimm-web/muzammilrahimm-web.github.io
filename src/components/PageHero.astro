---
// PageHero: the title area at the top of inner pages (categories, blog, legal...).
// The image is optional.
import { Image } from 'astro:assets';

const { eyebrow, title, intro, image, imageAlt } = Astro.props;
---

<section class:list={['page-hero', { 'page-hero--image': image }]}>
  <div class="container page-hero__inner">
    <div class="page-hero__text">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h1>{title}</h1>
      {intro && <p class="lead">{intro}</p>}
      <slot />
    </div>
    {
      image && (
        <div class="page-hero__media">
          <Image
            src={image}
            alt={imageAlt}
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 45vw, 100vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    padding-block: var(--space-xl);
    background: var(--beige);
    border-bottom: 1px solid var(--line);
  }

  .page-hero__inner {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }

  .page-hero__text {
    display: grid;
    gap: var(--space-sm);
    justify-items: start;
  }

  .page-hero h1 {
    font-size: clamp(2.4rem, 5vw, 3.75rem);
  }

  .page-hero__media {
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--beige-deep);
  }

  .page-hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 1024px) {
    .page-hero--image .page-hero__inner {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
    }
  }
</style>
