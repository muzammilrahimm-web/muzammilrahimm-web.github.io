---
// PasswordField: password input with a Show/Hide button and error message area.
// Extra props (required, minlength, pattern, autocomplete...) go to the <input>.
const { id, label = 'Password', hint, ...inputProps } = Astro.props;
const describedBy = [`${id}-error`, hint && `${id}-hint`].filter(Boolean).join(' ');
---

<div class="field">
  <div class="password-field__label-row">
    <label for={id}>{label}</label>
    <slot name="label-extra" />
  </div>
  <div class="password-field">
    <input
      id={id}
      name={id}
      type="password"
      class="input password-field__input"
      data-label={label}
      data-password
      aria-describedby={describedBy}
      {...inputProps}
    />
    <button
      type="button"
      class="password-field__toggle"
      aria-controls={id}
      aria-pressed="false"
      aria-label="Show password"
      data-password-toggle
    >
      <span data-toggle-text>Show</span>
    </button>
  </div>
  {hint && <p class="field-hint" id={`${id}-hint`}>{hint}</p>}
  <p class="field-error" id={`${id}-error`} aria-live="polite"></p>
</div>

<style>
  .password-field__label-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .password-field {
    position: relative;
  }

  .password-field__input {
    padding-right: 4.75rem;
  }

  .password-field__toggle {
    position: absolute;
    top: 50%;
    right: 0.4rem;
    transform: translateY(-50%);
    min-width: 60px;
    min-height: 40px;
    padding: 0 0.75rem;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--sage-dark);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .password-field__toggle:hover {
    background: var(--beige);
  }
</style>
