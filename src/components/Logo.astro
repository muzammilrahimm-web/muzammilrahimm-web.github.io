---
// Logo: the Nestora wordmark with a small nest/house icon. Links to the homepage.
const { class: className = '' } = Astro.props;
---

<a href="/" class:list={['logo', className]} aria-label="Nestora home">
  <svg class="logo__mark" width="30" height="30" viewBox="0 0 32 32" aria-hidden="true">
    <path d="M4 15.5 16 5l12 10.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M8 13.5V26h16V13.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
    <path d="M12 22c2.5 1.6 5.5 1.6 8 0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  </svg>
  <span class="logo__text">Nestora</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink);
    text-decoration: none;
  }

  .logo:hover {
    color: var(--ink);
  }

  .logo__mark {
    color: var(--sage-dark);
  }

  .logo__text {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1;
  }
</style>
