---
// DemoBadge: a small label that clearly marks sample/placeholder content.
const { label = 'Demo content' } = Astro.props;
---

<span class="demo-badge">{label}</span>

<style>
  .demo-badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--sage-light);
    color: var(--sage-darker);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>
