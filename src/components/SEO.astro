---
// SEO component: outputs the <meta> tags search engines and social sites need.
// Used inside BaseLayout, so every page gets these tags automatically.
import { getImage } from 'astro:assets';
import { SITE } from '../config/site.js';
import defaultShareImage from '../assets/images/hero-living-room.jpg';

const {
  title,
  description = SITE.description,
  image, // optional imported image for social sharing
  noindex = false,
  type = 'website',
  article, // optional { publishedTime: Date, modifiedTime?: Date, section?: string }
} = Astro.props;

// "Page Title | Nestora". The homepage uses "Nestora | tagline".
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} | ${SITE.tagline}`;

// Canonical URL tells Google the one "official" address of this page.
const base = Astro.site ?? SITE.url;
const canonicalURL = new URL(Astro.url.pathname, base);

// Social sharing image (optimized JPG, 1200px wide).
const shareImage = await getImage({ src: image ?? defaultShareImage, width: 1200, format: 'jpg' });
const imageURL = new URL(shareImage.src, base).href;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL.href} />
<meta name="robots" content={noindex ? (noindex === 'follow' ? 'noindex, follow' : 'noindex, nofollow') : 'index, follow'} />

<!-- Open Graph (Facebook, Pinterest, LinkedIn, etc.) -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL.href} />
<meta property="og:locale" content={SITE.locale} />
{SITE.alternateLocales.map((loc) => <meta property="og:locale:alternate" content={loc} />)}
<meta property="og:image" content={imageURL} />
{article?.publishedTime && <meta property="article:published_time" content={article.publishedTime.toISOString()} />}
{article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />}
{article?.section && <meta property="article:section" content={article.section} />}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

<!-- Sitemap location (generated automatically at build time) -->
<link rel="sitemap" href="/sitemap-index.xml" />
